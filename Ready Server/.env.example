PORT=5000
NODE_ENV=development

# ==============================================================================
# UNIVERSAL DATABASE CONFIGURATION (Supports ANY PostgreSQL Provider)
# ==============================================================================
# Local Postgres:  postgresql://postgres:postgres@localhost:5432/hackathon_db
# Supabase:        postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Neon:            postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require
# Railway:         postgresql://postgres:[PASSWORD]@[HOST].railway.app:5432/railway
# Render:          postgresql://[USER]:[PASSWORD]@[HOST].render.com/[DB_NAME]?ssl=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hackathon_db"

# Optional explicit SSL override (true/false) - Auto-detected if cloud DB is detected
# DB_SSL=true

JWT_SECRET=super_secret_hackathon_jwt_key_12345
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
CLIENT_URL=http://localhost:3000

# Cloudinary Storage (Optional - falls back to local /public/uploads if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nodemailer Email & OTP Configuration (Gmail / SMTP / Console fallback)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME="Hackathon Backend"

# Alternative Custom SMTP Configuration
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false
